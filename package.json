{
  "name": "elsim",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "vite",
    "desktop:dev": "node tools/desktop-preflight.mjs dev && tauri dev",
    "desktop:build": "node tools/desktop-preflight.mjs build && tauri build",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build && node tools/check-web-build.mjs",
    "build:offline": "npm run typecheck && vite build --mode offline",
    "build:pages": "npm run typecheck && npm run check:pages-base",
    "test": "node tests/run-netlist-tests.cjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --grep @ui-smoke --grep-invert \"@ngspice|@ltspice\"",
    "test:e2e:ui:smoke": "npm run test:e2e:ui",
    "test:e2e:engine": "playwright test --grep \"@engine-smoke\"",
    "test:e2e:engine:full": "playwright test --grep \"@ngspice\" --grep-invert \"@ltspice\"",
    "test:e2e:ltspice": "playwright test --grep \"@ltspice\"",
    "test:e2e:engine:firefox": "npm run test:e2e:engine -- --browser=firefox",
    "test:e2e:engine:full:firefox": "npm run test:e2e:engine:full -- --browser=firefox",
    "test:e2e:focus:firefox": "playwright test --config playwright.firefox.engine.config.ts",
    "test:e2e:engine:pages-base": "playwright test --config playwright.pages-base.config.ts",
    "test:e2e:compat": "playwright test --config playwright.firefox.config.ts",
    "test:e2e:pwa": "playwright test --config playwright.pwa.config.ts",
    "test:e2e:pwa:firefox": "npm run test:e2e:pwa -- --browser=firefox",
    "check:pages-base": "node tools/check-pages-base-build.mjs",
    "benchmark:performance": "node tools/benchmark-performance.mjs",
    "benchmark:performance:quick": "node tools/benchmark-performance.mjs --skip-engine",
    "benchmark:browser": "playwright test --config playwright.performance.config.ts",
    "benchmark:browser:memory": "python3 tools/benchmark-firefox-memory.py",
    "test:wasm": "node tools/test-ngspice-wasm.mjs",
    "test:wasm:parity": "node tools/test-ngspice-wasm-parity.mjs",
    "check:ngspice-release": "node tools/check-ngspice-release.mjs",
    "build:release": "npm run check:npm-licenses && npm run check:ngspice-release && npm run typecheck && vite build --mode release",
    "preview": "vite preview",
    "check:npm-licenses": "node tools/check-npm-license-inventory.mjs",
    "test:e2e:ui:full": "playwright test --grep-invert \"@ngspice|@ltspice\"",
    "build:ngspice:native": "./tools/build-ngspice-native.sh"
  },
  "dependencies": {
    "lucide-react": "0.468.0",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.55.1",
    "@tauri-apps/cli": "^2.12.4",
    "@types/react": "19.1.0",
    "@types/react-dom": "19.1.0",
    "@vitejs/plugin-react": "4.7.0",
    "typescript": "5.8.3",
    "vite": "6.4.4"
  }
}
