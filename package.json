{
  "name": "elsim",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=18.0.0" },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build && node tools/check-web-build.mjs",
    "test": "node tests/run-netlist-tests.cjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --grep-invert \"first use: run the RC starter|import, place, and simulate a user-supplied IC\"",
    "test:e2e:compat": "playwright test --config playwright.browser-matrix.config.ts",
    "test:e2e:pwa": "playwright test --config playwright.pwa.config.ts",
    "test:wasm": "node tools/test-ngspice-wasm.mjs",
    "check:ngspice-release": "node tools/check-ngspice-release.mjs",
    "build:release": "npm run check:ngspice-release && npm run typecheck && vite build --mode release",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "lucide-react": "0.468.0"
  },
  "devDependencies": {
    "@types/react": "19.1.0",
    "@types/react-dom": "19.1.0",
    "@vitejs/plugin-react": "4.7.0",
    "typescript": "5.8.3",
    "@playwright/test": "1.55.1",
    "vite": "6.4.4"
  }
}
