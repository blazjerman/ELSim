{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elsim.dev/schemas/engine-protocol.schema.json",
  "title": "ELSim engine worker protocol v1",
  "oneOf": [
    { "$ref": "#/$defs/request" },
    { "$ref": "#/$defs/response" }
  ],
  "$defs": {
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["severity", "message"],
      "properties": {
        "severity": { "enum": ["info", "warning", "error"] },
        "message": { "type": "string" },
        "hint": { "type": "string" },
        "sourceId": { "type": "string" },
        "line": { "type": "integer", "minimum": 1 },
        "assetId": { "type": "string", "minLength": 1 },
        "assetLine": { "type": "integer", "minimum": 1 }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["line", "sourceId", "role"],
      "properties": {
        "line": { "type": "integer", "minimum": 1 },
        "sourceId": { "type": "string", "minLength": 1 },
        "role": { "enum": ["component", "model", "analysis", "generated"] },
        "assetId": { "type": "string", "minLength": 1 },
        "assetLine": { "type": "integer", "minimum": 1 }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "sourceMap", "diagnostics"],
      "properties": {
        "text": { "type": "string" },
        "sourceMap": { "type": "array", "items": { "$ref": "#/$defs/source" } },
        "diagnostics": { "type": "array", "items": { "$ref": "#/$defs/diagnostic" } }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runId", "startedAt", "engine", "engineVersion", "projectVersion", "netlistHash", "settings"],
      "properties": {
        "runId": { "type": "string", "minLength": 1 },
        "startedAt": { "type": "string", "format": "date-time" },
        "completedAt": { "type": "string", "format": "date-time" },
        "engine": { "type": "string" },
        "engineVersion": { "type": "string" },
        "projectVersion": { "type": "integer", "minimum": 1 },
        "netlistHash": { "type": "string" },
        "modelAssets": { "type": "array", "maxItems": 16, "items": { "$ref": "#/$defs/modelAssetFingerprint" } },
        "settings": { "type": "object", "additionalProperties": { "type": ["string", "number", "boolean"] } }
      }
    },
    "modelAssetFingerprint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "filename", "sha256"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "filename": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" }
      }
    },
    "trace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "unit", "axisLabel", "axisUnit", "axis", "values"],
      "properties": {
        "id": { "type": "string" },
        "label": { "type": "string" },
        "unit": { "type": "string" },
        "axis": { "type": "array", "items": { "type": "number" } },
        "values": { "type": "array", "items": { "type": "number" } },
        "axisLabel": { "type": "string" },
        "axisUnit": { "type": "string" },
        "imaginaryValues": { "type": "array", "items": { "type": "number" } },
        "baseId": { "type": "string" },
        "sweep": {
          "type": "object",
          "additionalProperties": false,
          "required": ["label", "index"],
          "properties": { "label": { "type": "string" }, "index": { "type": "integer", "minimum": 0 } }
        }
      }
    },
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "operation", "vector", "value", "unit"],
      "properties": {
        "id": { "type": "string" },
        "operation": { "enum": ["max", "min", "pp", "avg", "rms", "delay"] },
        "vector": { "type": "string" },
        "targetVector": { "type": "string" },
        "from": { "type": "string", "maxLength": 48 },
        "to": { "type": "string", "maxLength": 48 },
        "value": { "type": "number" },
        "unit": { "enum": ["V", "A", "s"] },
        "sweep": { "type": "object", "additionalProperties": false, "required": ["label", "index"], "properties": { "label": { "type": "string" }, "index": { "type": "integer", "minimum": 0 } } }
      }
    },
    "parameterSweepRun": {
      "type": "object",
      "additionalProperties": false,
      "required": ["values", "label"],
      "properties": {
        "values": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["component", "value"],
            "properties": { "component": { "type": "string", "minLength": 1 }, "value": { "type": "string", "pattern": "^-?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?$" }, "parameter": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" }, "model": { "type": "string", "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.$]*$" } }
          }
        },
        "label": { "type": "string" }
      }
    },
    "transientMeasurement": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["id", "operation", "vector"],
          "properties": {
            "id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]{0,23}$" },
            "operation": { "enum": ["max", "min", "pp", "avg", "rms"] },
            "vector": { "type": "string", "pattern": "^(?:v\\((?:0|[A-Za-z_][A-Za-z0-9_.$]*)\\)|i\\([RCLDS][A-Za-z0-9_]*\\))$" },
            "from": { "type": "string", "maxLength": 48 },
            "to": { "type": "string", "maxLength": 48 }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["id", "operation", "vector", "threshold", "targetVector", "targetThreshold", "edge", "targetEdge"],
          "properties": {
            "id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]{0,23}$" },
            "operation": { "const": "delay" },
            "vector": { "type": "string", "pattern": "^(?:v\\((?:0|[A-Za-z_][A-Za-z0-9_.$]*)\\)|i\\([RCLDS][A-Za-z0-9_]*\\))$" },
            "threshold": { "type": "string", "pattern": "^-?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?(?:[mM][eE][gG]|[tTgGkKmMuUnNpPfF])?[vVaA]?$" },
            "targetVector": { "type": "string", "pattern": "^(?:v\\((?:0|[A-Za-z_][A-Za-z0-9_.$]*)\\)|i\\([RCLDS][A-Za-z0-9_]*\\))$" },
            "targetThreshold": { "type": "string", "pattern": "^-?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?(?:[mM][eE][gG]|[tTgGkKmMuUnNpPfF])?[vVaA]?$" },
            "edge": { "enum": ["rise", "fall", "either"] },
            "targetEdge": { "enum": ["rise", "fall", "either"] },
            "triggerCount": { "type": "integer", "minimum": 1, "maximum": 9999 },
            "targetCount": { "type": "integer", "minimum": 1, "maximum": 9999 }
          }
        }
      ]
    },
    "request": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["type", "requestId"], "properties": { "type": { "const": "initialize" }, "requestId": { "type": "string" } } },
        { "type": "object", "additionalProperties": false, "required": ["type", "requestId", "artifact", "metadata"], "properties": { "type": { "const": "run" }, "requestId": { "type": "string" }, "artifact": { "$ref": "#/$defs/artifact" }, "metadata": { "$ref": "#/$defs/metadata" }, "parameterSweep": { "type": "array", "minItems": 1, "maxItems": 10, "items": { "$ref": "#/$defs/parameterSweepRun" } }, "measurements": { "type": "array", "maxItems": 12, "items": { "$ref": "#/$defs/transientMeasurement" } } } },
        { "type": "object", "additionalProperties": false, "required": ["type", "requestId", "runId"], "properties": { "type": { "const": "cancel" }, "requestId": { "type": "string" }, "runId": { "type": "string" } } },
        { "type": "object", "additionalProperties": false, "required": ["type", "requestId"], "properties": { "type": { "const": "dispose" }, "requestId": { "type": "string" } } }
      ]
    },
    "response": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["type", "requestId", "engine", "engineVersion"], "properties": { "type": { "const": "ready" }, "requestId": { "type": "string" }, "engine": { "type": "string" }, "engineVersion": { "type": "string" } } },
        { "type": "object", "additionalProperties": false, "required": ["type", "requestId", "runId", "fraction"], "properties": { "type": { "const": "progress" }, "requestId": { "type": "string" }, "runId": { "type": "string" }, "fraction": { "type": "number", "minimum": 0, "maximum": 1 }, "message": { "type": "string" } } },
        { "type": "object", "additionalProperties": false, "required": ["type", "requestId", "result"], "properties": { "type": { "const": "result" }, "requestId": { "type": "string" }, "result": { "type": "object", "additionalProperties": false, "required": ["metadata", "netlist", "sourceMap", "traces", "diagnostics", "analysis", "measurements"], "properties": { "metadata": { "$ref": "#/$defs/metadata" }, "netlist": { "type": "string" }, "sourceMap": { "type": "array", "items": { "$ref": "#/$defs/source" } }, "traces": { "type": "array", "items": { "$ref": "#/$defs/trace" } }, "diagnostics": { "type": "array", "items": { "$ref": "#/$defs/diagnostic" } }, "analysis": { "enum": ["tran", "op", "ac", "dc"] }, "measurements": { "type": "array", "items": { "$ref": "#/$defs/measurement" } } } } } },
        { "type": "object", "additionalProperties": false, "required": ["type", "requestId", "runId"], "properties": { "type": { "const": "cancelled" }, "requestId": { "type": "string" }, "runId": { "type": "string" } } },
        { "type": "object", "additionalProperties": false, "required": ["type", "requestId", "error"], "properties": { "type": { "const": "error" }, "requestId": { "type": "string" }, "error": { "$ref": "#/$defs/diagnostic" } } }
      ]
    }
  }
}
