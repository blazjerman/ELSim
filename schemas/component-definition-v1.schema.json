{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elsim.app/schemas/component-definition-v1.schema.json",
  "title": "ELSim component definition v1",
  "description": "Versioned reusable electrical component definition. Project instances continue storing their editable values and identity separately.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "version",
    "kind",
    "name",
    "electricalType",
    "pins",
    "properties",
    "animationChannels"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^(?:elsim\\.[a-z0-9-]+|user\\.[a-f0-9]{64}\\.[a-z0-9-]+)$",
      "maxLength": 160
    },
    "version": {
      "const": 1
    },
    "kind": {
      "type": "string",
      "enum": [
        "source",
        "currentSource",
        "resistor",
        "potentiometer",
        "lamp",
        "capacitor",
        "ground",
        "inductor",
        "transformer",
        "diode",
        "zener",
        "led",
        "switch",
        "voltageSwitch",
        "vcvs",
        "vccs",
        "cccs",
        "ccvs",
        "behavioral",
        "inverter",
        "logicGate",
        "npn",
        "pnp",
        "subcircuit",
        "nmos",
        "pmos",
        "njfet",
        "pjfet"
      ]
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "paletteName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "paletteSubtitle": {
      "type": "string",
      "maxLength": 24
    },
    "paletteCategory": {
      "enum": [
        "basics",
        "semiconductors",
        "controlled"
      ]
    },
    "shortcut": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8
    },
    "help": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "electricalType": {
      "type": "string",
      "enum": [
        "V",
        "I",
        "R",
        "C",
        "L",
        "T",
        "GND",
        "D",
        "J",
        "S",
        "E",
        "G",
        "F",
        "H",
        "B",
        "Q",
        "M",
        "X"
      ]
    },
    "pins": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "direction",
          "spiceOrder"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^(?:[0-9]+|[A-Za-z_][A-Za-z0-9_.$]*)$",
            "maxLength": 64
          },
          "displayName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "direction": {
            "enum": [
              "passive",
              "input",
              "output",
              "inout"
            ]
          },
          "spiceOrder": {
            "type": "integer",
            "minimum": 1,
            "maximum": 64
          }
        }
      }
    },
    "pinOffsets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "array",
        "prefixItems": [
          { "type": "number", "minimum": -100000, "maximum": 100000 },
          { "type": "number", "minimum": -100000, "maximum": 100000 }
        ],
        "minItems": 2,
        "maxItems": 2
      }
    },
    "symbolGeometry": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "x1", "y1", "x2", "y2"],
            "properties": {
              "kind": { "const": "line" },
              "x1": { "type": "number", "minimum": -1000, "maximum": 1000 },
              "y1": { "type": "number", "minimum": -1000, "maximum": 1000 },
              "x2": { "type": "number", "minimum": -1000, "maximum": 1000 },
              "y2": { "type": "number", "minimum": -1000, "maximum": 1000 }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "x", "y", "width", "height"],
            "properties": {
              "kind": { "const": "rect" },
              "x": { "type": "number", "minimum": -1000, "maximum": 1000 },
              "y": { "type": "number", "minimum": -1000, "maximum": 1000 },
              "width": { "type": "number", "minimum": 0, "maximum": 1000 },
              "height": { "type": "number", "minimum": 0, "maximum": 1000 },
              "rx": { "type": "number", "minimum": 0, "maximum": 500 }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "cx", "cy", "r"],
            "properties": {
              "kind": { "const": "circle" },
              "cx": { "type": "number", "minimum": -1000, "maximum": 1000 },
              "cy": { "type": "number", "minimum": -1000, "maximum": 1000 },
              "r": { "type": "number", "exclusiveMinimum": 0, "maximum": 500 }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "d"],
            "properties": {
              "kind": { "const": "path" },
              "d": { "type": "string", "minLength": 1, "maxLength": 4096 },
              "fill": { "enum": ["none", "stroke"] }
            }
          }
        ]
      }
    },
    "properties": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "label",
          "unit"
        ],
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9]*$",
            "maxLength": 64
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "unit": {
            "type": "string",
            "maxLength": 32
          },
          "defaultValue": {
            "type": "string",
            "maxLength": 128
          },
          "required": {
            "type": "boolean"
          }
        }
      }
    },
    "animationChannels": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-zA-Z0-9]*(?:\\.[a-zA-Z0-9]+)*$",
        "maxLength": 80
      }
    },
    "connectionHint": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "modelParameters": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "defaultValue"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
            "maxLength": 64
          },
          "defaultValue": {
            "type": "string",
            "maxLength": 128
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assetId",
        "filename",
        "sha256"
      ],
      "properties": {
        "assetId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "filename": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        }
      }
    }
  }
}
