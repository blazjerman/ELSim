{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elsim.dev/schemas/elsim-symbol-v1.schema.json",
  "title": "ELSim symbol v1",
  "description": "Data-only vector symbol with ordered model pins. No scripts, external resources, or markup are supported.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "name", "pins", "primitives"],
  "properties": {
    "format": { "const": "elsim-symbol" },
    "version": { "const": 1 },
    "name": { "type": "string", "minLength": 1, "maxLength": 80 },
    "pins": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "$ref": "#/$defs/pin" } },
    "primitives": { "type": "array", "maxItems": 2000, "items": { "$ref": "#/$defs/primitive" } }
  },
  "$defs": {
    "coordinate": { "type": "number", "minimum": -100000, "maximum": 100000 },
    "point": { "type": "array", "prefixItems": [{ "$ref": "#/$defs/coordinate" }, { "$ref": "#/$defs/coordinate" }], "minItems": 2, "maxItems": 2 },
    "pin": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "spiceOrder", "x", "y", "orientation"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 64 },
        "spiceOrder": { "type": "integer", "minimum": 1, "maximum": 64 },
        "x": { "$ref": "#/$defs/coordinate" }, "y": { "$ref": "#/$defs/coordinate" },
        "orientation": { "enum": ["R", "L", "U", "D"] }
      }
    },
    "line": { "type": "object", "additionalProperties": false, "required": ["kind", "x1", "y1", "x2", "y2"], "properties": { "kind": { "const": "line" }, "x1": { "$ref": "#/$defs/coordinate" }, "y1": { "$ref": "#/$defs/coordinate" }, "x2": { "$ref": "#/$defs/coordinate" }, "y2": { "$ref": "#/$defs/coordinate" } } },
    "polyline": { "type": "object", "additionalProperties": false, "required": ["kind", "points"], "properties": { "kind": { "const": "polyline" }, "points": { "type": "array", "minItems": 2, "maxItems": 256, "items": { "$ref": "#/$defs/point" } } } },
    "rectangle": { "type": "object", "additionalProperties": false, "required": ["kind", "x1", "y1", "x2", "y2"], "properties": { "kind": { "const": "rectangle" }, "x1": { "$ref": "#/$defs/coordinate" }, "y1": { "$ref": "#/$defs/coordinate" }, "x2": { "$ref": "#/$defs/coordinate" }, "y2": { "$ref": "#/$defs/coordinate" } } },
    "circle": { "type": "object", "additionalProperties": false, "required": ["kind", "x1", "y1", "x2", "y2"], "properties": { "kind": { "const": "circle" }, "x1": { "$ref": "#/$defs/coordinate" }, "y1": { "$ref": "#/$defs/coordinate" }, "x2": { "$ref": "#/$defs/coordinate" }, "y2": { "$ref": "#/$defs/coordinate" } } },
    "text": { "type": "object", "additionalProperties": false, "required": ["kind", "x", "y", "text"], "properties": { "kind": { "const": "text" }, "x": { "$ref": "#/$defs/coordinate" }, "y": { "$ref": "#/$defs/coordinate" }, "text": { "type": "string", "maxLength": 256 }, "alignment": { "enum": ["Left", "Center", "Right"] }, "size": { "type": "number", "minimum": 1, "maximum": 16 } } },
    "path": { "type": "object", "additionalProperties": false, "required": ["kind", "d"], "properties": { "kind": { "const": "path" }, "d": { "type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^[MmLlHhVvCcSsQqTtAaZz0-9eE+.,\\s-]+$" } } },
    "primitive": { "oneOf": [{ "$ref": "#/$defs/line" }, { "$ref": "#/$defs/polyline" }, { "$ref": "#/$defs/rectangle" }, { "$ref": "#/$defs/circle" }, { "$ref": "#/$defs/text" }, { "$ref": "#/$defs/path" }] }
  }
}
