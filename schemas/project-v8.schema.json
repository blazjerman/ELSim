{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elsim.dev/schemas/project-v8.schema.json",
  "title": "ELSim project v8",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "version",
    "name",
    "updatedAt",
    "parts",
    "wires",
    "junctions",
    "netLabels",
    "view",
    "simulation",
    "rootSheetId",
    "sheets",
    "activeSheetId"
  ],
  "properties": {
    "format": {
      "const": "elsim-project"
    },
    "version": {
      "const": 8
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "parts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/part"
      }
    },
    "wires": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/wire"
      }
    },
    "junctions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/point"
      }
    },
    "netLabels": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/netLabel"
      }
    },
    "view": {
      "$ref": "#/$defs/view"
    },
    "simulation": {
      "$ref": "#/$defs/simulation"
    },
    "plotSettings": {
      "$ref": "#/$defs/plotSettings"
    },
    "modelAssets": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "$ref": "#/$defs/modelAsset"
      }
    },
    "symbolAssets": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/symbolAsset"
      }
    },
    "importedSchematicSource": {
      "$ref": "#/$defs/ltspiceSchematicSource"
    },
    "importedChildSchematicSources": {
      "type": "array",
      "maxItems": 63,
      "items": {
        "$ref": "#/$defs/ltspiceSchematicSource"
      }
    },
    "rootSheetId": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
    },
    "sheets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/sheet"
      }
    },
    "activeSheetId": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
    }
  },
  "$defs": {
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y"
      ],
      "properties": {
        "x": {
          "type": "number",
          "description": "ELSim-authored scene coordinates are normalized to the 10-unit editor grid. Imported source geometry retains its original coordinates."
        },
        "y": {
          "type": "number",
          "description": "ELSim-authored scene coordinates are normalized to the 10-unit editor grid. Imported source geometry retains its original coordinates."
        }
      }
    },
    "part": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "ref",
        "value",
        "x",
        "y",
        "rotation"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "source",
            "currentSource",
            "resistor",
            "potentiometer",
            "lamp",
            "capacitor",
            "ground",
            "inductor",
            "transformer",
            "diode",
            "zener",
            "led",
            "switch",
            "voltageSwitch",
            "vcvs",
            "vccs",
            "cccs",
            "ccvs",
            "behavioral",
            "inverter",
            "logicGate",
            "npn",
            "pnp",
            "nmos",
            "pmos",
            "subcircuit",
            "njfet",
            "pjfet"
          ]
        },
        "componentDefinitionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "description": "Stable built-in or content-addressed component definition used by this instance. Older v7 projects may omit it and receive it during validation."
        },
        "ref": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
        },
        "value": {
          "type": "string"
        },
        "x": {
          "type": "number",
          "description": "ELSim-authored scene coordinates are normalized to the 10-unit editor grid. Imported source geometry retains its original coordinates."
        },
        "y": {
          "type": "number",
          "description": "ELSim-authored scene coordinates are normalized to the 10-unit editor grid. Imported source geometry retains its original coordinates."
        },
        "rotation": {
          "enum": [
            0,
            90,
            180,
            270
          ]
        },
        "flipX": {
          "type": "boolean",
          "default": false
        },
        "modelName": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_.$]*$"
        },
        "modelPins": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "string",
            "pattern": "^(?:[0-9]+|[A-Za-z_][A-Za-z0-9_.$]*)$"
          }
        },
        "sheetParameters": {
          "type": "object",
          "maxProperties": 32,
          "additionalProperties": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^\\{?[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?(?:meg|[tgkmunpf])?\\}?$"
          }
        },
        "modelParameters": {
          "type": "object",
          "maxProperties": 32,
          "additionalProperties": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^\\{?[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?(?:meg|[tgkmunpf])?\\}?$"
          }
        },
        "deviceModel": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.$]*$"
        },
        "controlSource": {
          "type": "string",
          "pattern": "^V[A-Za-z0-9_]*$"
        },
        "behavioralOutput": {
          "enum": [
            "voltage",
            "current"
          ]
        },
        "logicOperation": {
          "enum": ["and", "or", "nand", "nor", "xor", "xnor"]
        },
        "logicLow": { "type": "string", "maxLength": 64 },
        "logicHigh": { "type": "string", "maxLength": 64 },
        "logicThreshold": { "type": "string", "maxLength": 64 },
        "behavioralDialect": {
          "const": "ltspice"
        },
        "sourceMode": {
          "enum": [
            "pulse",
            "dc",
            "pwl",
            "sine",
            "exp",
            "sffm"
          ],
          "description": "For transient analysis, voltage and independent current sources support pulse, DC, PWL, or SINE. Omitted voltage-source mode preserves historical pulse behavior; omitted current-source mode means scalar DC."
        },
        "acMagnitude": {
          "type": "string",
          "maxLength": 64,
          "description": "Optional per-source small-signal AC magnitude; overrides the project default for voltage sources and the DC value for current sources."
        },
        "acPhase": {
          "type": "string",
          "maxLength": 64,
          "description": "Optional per-source small-signal AC phase in degrees; defaults to zero."
        },
        "pulse": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "initial",
            "delay",
            "rise",
            "fall",
            "width",
            "period"
          ],
          "properties": {
            "initial": {
              "type": "string",
              "maxLength": 64
            },
            "delay": {
              "type": "string",
              "maxLength": 64
            },
            "rise": {
              "type": "string",
              "maxLength": 64
            },
            "fall": {
              "type": "string",
              "maxLength": 64
            },
            "width": {
              "type": "string",
              "maxLength": 64
            },
            "period": {
              "type": "string",
              "maxLength": 64
            },
            "cycleCount": {
              "type": "string",
              "maxLength": 64,
              "description": "Optional nonnegative whole number of pulses; zero or omission means repeat indefinitely."
            }
          },
          "description": "Optional LTspice-compatible voltage or current pulse level, timing, and cycle count; omitted fields use the ELSim default pulse."
        },
        "sine": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "offset",
            "amplitude",
            "frequency",
            "delay",
            "damping",
            "phase"
          ],
          "properties": {
            "offset": {
              "type": "string",
              "maxLength": 64
            },
            "amplitude": {
              "type": "string",
              "maxLength": 64
            },
            "frequency": {
              "type": "string",
              "maxLength": 64
            },
            "delay": {
              "type": "string",
              "maxLength": 64
            },
            "damping": {
              "type": "string",
              "maxLength": 64
            },
            "phase": {
              "type": "string",
              "maxLength": 64
            }
          },
          "description": "Optional voltage/current-source transient SINE settings: offset and amplitude in the source quantity, frequency, delay, damping factor, and phase degrees."
        },
        "exp": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "initial",
            "pulsed",
            "riseDelay",
            "riseTau",
            "fallDelay",
            "fallTau"
          ],
          "properties": {
            "initial": {
              "type": "string",
              "maxLength": 64
            },
            "pulsed": {
              "type": "string",
              "maxLength": 64
            },
            "riseDelay": {
              "type": "string",
              "maxLength": 64
            },
            "riseTau": {
              "type": "string",
              "maxLength": 64
            },
            "fallDelay": {
              "type": "string",
              "maxLength": 64
            },
            "fallTau": {
              "type": "string",
              "maxLength": 64
            }
          },
          "description": "Optional transient EXP source settings: initial and pulsed source quantity, rise delay/time constant, and fall delay/time constant."
        },
        "sffm": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "offset",
            "amplitude",
            "carrierFrequency",
            "modulationIndex",
            "signalFrequency"
          ],
          "properties": {
            "offset": {
              "type": "string",
              "maxLength": 64
            },
            "amplitude": {
              "type": "string",
              "maxLength": 64
            },
            "carrierFrequency": {
              "type": "string",
              "maxLength": 64
            },
            "modulationIndex": {
              "type": "string",
              "maxLength": 64
            },
            "signalFrequency": {
              "type": "string",
              "maxLength": 64
            }
          },
          "description": "LTspice SFFM source settings: offset, amplitude, carrier frequency, modulation index, and modulating signal frequency."
        },
        "pwl": {
          "type": "array",
          "minItems": 2,
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "time",
              "voltage"
            ],
            "properties": {
              "time": {
                "type": "string",
                "maxLength": 64
              },
              "voltage": {
                "type": "string",
                "maxLength": 64
              }
            }
          },
          "description": "Piecewise-linear voltage source points in strictly increasing time order."
        },
        "pwlFileName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "description": "Filename from a user-provided LTspice PWL data file; its parsed point values are stored in the project."
        },
        "pwlRepeat": {
          "enum": [
            "forever"
          ],
          "description": "Repeat a voltage- or current-source PWL point sequence forever."
        },
        "pwlRepeatCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 31,
          "description": "Repeat a voltage- or current-source PWL point sequence this many times in total. Finite repeats require matching first and last levels; expanded source tables are limited to 32 points."
        },
        "currentPwl": {
          "type": "array",
          "minItems": 2,
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "time",
              "current"
            ],
            "properties": {
              "time": {
                "type": "string",
                "maxLength": 64
              },
              "current": {
                "type": "string",
                "maxLength": 64
              }
            }
          },
          "description": "Piecewise-linear independent current source points in strictly increasing time order."
        },
        "extensions": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ltspice": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "attributes": {
                  "type": "object",
                  "maxProperties": 16,
                  "propertyNames": {
                    "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
                  },
                  "additionalProperties": {
                    "type": "string",
                    "maxLength": 512
                  }
                }
              }
            }
          }
        },
        "animationNominalPower": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100000,
          "description": "Nominal electrical power in watts used only to scale lamp brightness."
        },
        "polarized": {
          "type": "boolean",
          "description": "Render a positive and negative terminal marker on a polarized capacitor."
        },
        "turnsRatio": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?$",
          "description": "Positive secondary-to-primary turns ratio for the built-in coupled-inductor transformer."
        },
        "coupling": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?$",
          "description": "Magnetic coupling coefficient greater than zero and at most one for the built-in coupled-inductor transformer."
        },
        "seriesResistance": {
          "type": "string",
          "maxLength": 64,
          "description": "Optional nonnegative series resistance (ohms) for capacitor ESR or inductor winding loss."
        },
        "wiperPosition": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?$",
          "description": "Potentiometer wiper fraction from upper terminal to lower terminal, from 0.001 to 0.999."
        },
        "symbolAssetId": {
          "type": "string",
          "minLength": 1
        },
        "symbolPinOffsets": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "array",
            "prefixItems": [
              {
                "type": "number",
                "minimum": -100000,
                "maximum": 100000
              },
              {
                "type": "number",
                "minimum": -100000,
                "maximum": 100000
              }
            ],
            "minItems": 2,
            "maxItems": 2
          }
        },
        "sheetId": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
        },
        "sheetPortLayout": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "side",
              "direction"
            ],
            "properties": {
              "side": {
                "enum": [
                  "auto",
                  "left",
                  "right",
                  "top",
                  "bottom"
                ]
              },
              "direction": {
                "enum": [
                  "input",
                  "output",
                  "inout"
                ]
              }
            }
          }
        },
        "voltageSwitch": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "onResistance": {
              "type": "string",
              "maxLength": 64
            },
            "offResistance": {
              "type": "string",
              "maxLength": 64
            },
            "hysteresis": {
              "type": "string",
              "maxLength": 64
            }
          },
          "description": "Optional voltage-controlled switch parameters; omitted values use 1 \u03a9, 1 G\u03a9, and 0 V defaults."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "subcircuit"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "modelName",
              "modelPins"
            ]
          }
        },
        {
          "if": {
            "required": [
              "symbolAssetId"
            ]
          },
          "then": {
            "required": [
              "symbolPinOffsets"
            ]
          }
        },
        {
          "if": {
            "required": [
              "symbolPinOffsets"
            ]
          },
          "then": {
            "required": [
              "symbolAssetId"
            ]
          }
        }
      ]
    },
    "modelAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "filename",
        "sha256",
        "content",
        "licenseStatus",
        "importedAt"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "filename": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^/\\\\\\u0000-\\u001f]+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "content": {
          "type": "string",
          "maxLength": 4194304
        },
        "selectedSections": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$"
          }
        },
        "licenseStatus": {
          "const": "unknown"
        },
        "importedAt": {
          "type": "string",
          "format": "date-time"
        },
        "sourceUrl": {
          "type": "string",
          "maxLength": 2048
        },
        "licenseReference": {
          "type": "string",
          "maxLength": 128
        },
        "rightsNotes": {
          "type": "string",
          "maxLength": 1000
        }
      }
    },
    "symbolAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "filename",
        "sha256",
        "content",
        "licenseStatus",
        "importedAt"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "filename": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^/\\\\\\u0000-\\u001f]+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "content": {
          "type": "string",
          "maxLength": 1048576
        },
        "licenseStatus": {
          "const": "unknown"
        },
        "importedAt": {
          "type": "string",
          "format": "date-time"
        },
        "sourceUrl": {
          "type": "string",
          "maxLength": 2048
        },
        "licenseReference": {
          "type": "string",
          "maxLength": 128
        },
        "rightsNotes": {
          "type": "string",
          "maxLength": 1000
        }
      }
    },
    "ltspiceSchematicSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "filename",
        "originalText"
      ],
      "properties": {
        "format": {
          "const": "ltspice-asc"
        },
        "filename": {
          "type": "string",
          "minLength": 1
        },
        "originalText": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10485760
        },
        "sourceUrl": {
          "type": "string",
          "maxLength": 2048
        },
        "licenseReference": {
          "type": "string",
          "maxLength": 128
        },
        "rightsNotes": {
          "type": "string",
          "maxLength": 1000
        }
      }
    },
    "wire": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "points"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "points": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "array",
            "prefixItems": [
              {
                "type": "number",
                "description": "ELSim-authored scene coordinates are normalized to the 10-unit editor grid. Imported source geometry retains its original coordinates."
              },
              {
                "type": "number",
                "description": "ELSim-authored scene coordinates are normalized to the 10-unit editor grid. Imported source geometry retains its original coordinates."
              }
            ],
            "minItems": 2,
            "maxItems": 2
          },
          "maxItems": 2,
          "description": "A wire is one straight connection between two endpoint coordinates. Use multiple wire objects to make a path."
        }
      }
    },
    "netLabel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "x",
        "y"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "pattern": "^(0|[A-Za-z_][A-Za-z0-9_.$]*)$"
        },
        "x": {
          "type": "number",
          "description": "ELSim-authored scene coordinates are normalized to the 10-unit editor grid. Imported source geometry retains its original coordinates."
        },
        "y": {
          "type": "number",
          "description": "ELSim-authored scene coordinates are normalized to the 10-unit editor grid. Imported source geometry retains its original coordinates."
        },
        "visible": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "view": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "zoom",
        "panX",
        "panY"
      ],
      "properties": {
        "zoom": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "panX": {
          "type": "number"
        },
        "panY": {
          "type": "number"
        }
      }
    },
    "plotSettings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selectedTraceIds",
        "ranges"
      ],
      "properties": {
        "selectedTraceIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ranges": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "tran": {
              "$ref": "#/$defs/plotRange"
            },
            "ac": {
              "$ref": "#/$defs/plotRange"
            },
            "dc": {
              "$ref": "#/$defs/plotRange"
            },
            "noise": {
              "$ref": "#/$defs/plotRange"
            }
          }
        },
        "detachedWindow": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "x",
            "y",
            "width",
            "height"
          ],
          "properties": {
            "x": {
              "type": "number",
              "minimum": -100000,
              "maximum": 100000
            },
            "y": {
              "type": "number",
              "minimum": -100000,
              "maximum": 100000
            },
            "width": {
              "type": "number",
              "minimum": 280,
              "maximum": 4000
            },
            "height": {
              "type": "number",
              "minimum": 160,
              "maximum": 3000
            }
          }
        },
        "panels": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/plotPanel"
          }
        }
      }
    },
    "plotPanel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "bounds",
        "selectedTraceIds",
        "ranges"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,64}$"
        },
        "bounds": {
          "$ref": "#/$defs/plotWindowBounds"
        },
        "selectedTraceIds": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "string"
          }
        },
        "ranges": {
          "$ref": "#/$defs/plotRanges"
        }
      }
    },
    "plotWindowBounds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "properties": {
        "x": {
          "type": "number",
          "minimum": -100000,
          "maximum": 100000
        },
        "y": {
          "type": "number",
          "minimum": -100000,
          "maximum": 100000
        },
        "width": {
          "type": "number",
          "minimum": 280,
          "maximum": 4000
        },
        "height": {
          "type": "number",
          "minimum": 160,
          "maximum": 3000
        }
      }
    },
    "plotRanges": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tran": {
          "$ref": "#/$defs/plotRange"
        },
        "ac": {
          "$ref": "#/$defs/plotRange"
        },
        "dc": {
          "$ref": "#/$defs/plotRange"
        },
        "noise": {
          "$ref": "#/$defs/plotRange"
        }
      }
    },
    "plotRange": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "start": {
          "type": "number",
          "minimum": 0
        },
        "end": {
          "type": "number",
          "maximum": 1
        }
      }
    },
    "simulation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "analysis",
        "stopTime",
        "maxStep"
      ],
      "properties": {
        "analysis": {
          "enum": [
            "tran",
            "op",
            "ac",
            "dc",
            "noise"
          ]
        },
        "stopTime": {
          "type": "string",
          "minLength": 1
        },
        "maxStep": {
          "type": "string",
          "minLength": 1
        },
        "temperature": {
          "type": "string",
          "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)$"
        },
        "noiseSweep": {
          "type": "object",
          "additionalProperties": false,
          "required": ["outputNode", "inputSource", "scale", "points", "startFrequency", "stopFrequency"],
          "properties": {
            "outputNode": { "type": "string", "minLength": 1, "maxLength": 64 },
            "inputSource": { "type": "string", "pattern": "^[VI][A-Za-z0-9_]{0,63}$" },
            "scale": { "enum": ["dec", "oct", "lin"] },
            "points": { "type": "integer", "minimum": 1, "maximum": 10000 },
            "startFrequency": { "type": "string", "minLength": 1, "maxLength": 64 },
            "stopFrequency": { "type": "string", "minLength": 1, "maxLength": 64 }
          }
        },
        "sourceAcMagnitude": {
          "type": "string",
          "minLength": 1
        },
        "dcSweep": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source",
            "start",
            "stop",
            "step"
          ],
          "properties": {
            "source": {
              "type": "string",
              "minLength": 1
            },
            "start": {
              "type": "string",
              "minLength": 1
            },
            "stop": {
              "type": "string",
              "minLength": 1
            },
            "step": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "parameterSweeps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "component",
              "start",
              "stop",
              "points"
            ],
            "properties": {
              "component": {
                "type": "string",
                "minLength": 1
              },
              "parameter": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
              },
              "sourceParameter": {
                "enum": [
                  "pulse.initial",
                  "pulse.high",
                  "pulse.delay",
                  "pulse.rise",
                  "pulse.fall",
                  "pulse.width",
                  "pulse.period",
                  "pwl.scale",
                  "pwl.point.1",
                  "pwl.point.2",
                  "pwl.point.3",
                  "pwl.point.4",
                  "pwl.point.5",
                  "pwl.point.6",
                  "pwl.point.7",
                  "pwl.point.8",
                  "pwl.point.9",
                  "pwl.point.10",
                  "pwl.point.11",
                  "pwl.point.12",
                  "pwl.point.13",
                  "pwl.point.14",
                  "pwl.point.15",
                  "pwl.point.16",
                  "pwl.point.17",
                  "pwl.point.18",
                  "pwl.point.19",
                  "pwl.point.20",
                  "pwl.point.21",
                  "pwl.point.22",
                  "pwl.point.23",
                  "pwl.point.24",
                  "pwl.point.25",
                  "pwl.point.26",
                  "pwl.point.27",
                  "pwl.point.28",
                  "pwl.point.29",
                  "pwl.point.30",
                  "pwl.point.31",
                  "pwl.point.32",
                  "sine.offset",
                  "sine.amplitude",
                  "sine.frequency",
                  "sine.delay",
                  "sine.damping",
                  "sine.phase",
                  "exp.initial",
                  "exp.pulsed",
                  "exp.riseDelay",
                  "exp.riseTau",
                  "exp.fallDelay",
                  "exp.fallTau",
                  "sffm.offset",
                  "sffm.amplitude",
                  "sffm.carrierFrequency",
                  "sffm.modulationIndex",
                  "sffm.signalFrequency"
                ]
              },
              "start": {
                "type": "string",
                "minLength": 1
              },
              "stop": {
                "type": "string",
                "minLength": 1
              },
              "points": {
                "type": "integer",
                "minimum": 2,
                "maximum": 10
              }
            }
          }
        },
        "transientMeasurements": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "operation",
              "vector"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_]{0,23}$"
              },
              "operation": {
                "enum": [
                  "max",
                  "min",
                  "pp",
                  "avg",
                  "rms",
                  "integ",
                  "delay"
                ]
              },
              "vector": {
                "type": "string",
                "pattern": "^(?:v\\((?:0|[A-Za-z_][A-Za-z0-9_.$]*)\\)|i\\([RCLDS][A-Za-z0-9_]*\\))$"
              },
              "from": {
                "type": "string",
                "maxLength": 48
              },
              "to": {
                "type": "string",
                "maxLength": 48
              },
              "threshold": {
                "type": "string"
              },
              "targetVector": {
                "type": "string",
                "pattern": "^(?:v\\((?:0|[A-Za-z_][A-Za-z0-9_.$]*)\\)|i\\([RCLDS][A-Za-z0-9_]*\\))$"
              },
              "targetThreshold": {
                "type": "string"
              },
              "edge": {
                "enum": [
                  "rise",
                  "fall",
                  "either"
                ]
              },
              "targetEdge": {
                "enum": [
                  "rise",
                  "fall",
                  "either"
                ]
              },
              "triggerCount": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9999
              },
              "targetCount": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9999
              }
            }
          }
        },
        "initialConditions": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "node",
                  "voltage"
                ],
                "properties": {
                  "node": {
                    "type": "string",
                    "pattern": "^[A-Za-z_][A-Za-z0-9_.$]*$"
                  },
                  "voltage": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "element",
                  "voltage"
                ],
                "properties": {
                  "element": {
                    "type": "string",
                    "pattern": "^C[A-Za-z0-9_]+$"
                  },
                  "voltage": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "element",
                  "current"
                ],
                "properties": {
                  "element": {
                    "type": "string",
                    "pattern": "^L[A-Za-z0-9_]+$"
                  },
                  "current": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            ]
          }
        },
        "skipInitialOperatingPoint": {
          "type": "boolean"
        },
        "acSweep": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scale",
            "points",
            "startFrequency",
            "stopFrequency"
          ],
          "properties": {
            "scale": {
              "enum": [
                "dec",
                "oct",
                "lin"
              ]
            },
            "points": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000
            },
            "startFrequency": {
              "type": "string",
              "minLength": 1
            },
            "stopFrequency": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "sheet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "parentSheetId",
        "parts",
        "wires",
        "junctions",
        "netLabels",
        "view",
        "ports"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "parentSheetId": {
          "type": [
            "string",
            "null"
          ]
        },
        "parts": {
          "type": "array",
          "maxItems": 10000,
          "items": {
            "$ref": "#/$defs/part"
          }
        },
        "wires": {
          "type": "array",
          "maxItems": 20000,
          "items": {
            "$ref": "#/$defs/wire"
          }
        },
        "junctions": {
          "type": "array",
          "maxItems": 20000,
          "items": {
            "$ref": "#/$defs/point"
          }
        },
        "netLabels": {
          "type": "array",
          "maxItems": 20000,
          "items": {
            "$ref": "#/$defs/netLabel"
          }
        },
        "view": {
          "$ref": "#/$defs/view"
        },
        "ports": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "name",
              "side",
              "direction"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
              },
              "name": {
                "type": "string",
                "pattern": "^(?:0|[A-Za-z_][A-Za-z0-9_.$]*)$"
              },
              "side": {
                "enum": [
                  "auto",
                  "left",
                  "right",
                  "top",
                  "bottom"
                ]
              },
              "direction": {
                "enum": [
                  "input",
                  "output",
                  "inout"
                ]
              }
            }
          }
        },
        "parameters": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "name",
              "defaultValue"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
              },
              "name": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
              },
              "defaultValue": {
                "type": "string",
                "maxLength": 64,
                "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?(?:meg|[tgkmunpf])?$"
              }
            }
          }
        }
      }
    }
  }
}
